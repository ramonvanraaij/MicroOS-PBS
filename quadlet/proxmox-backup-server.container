# =================================================================

[Unit]
Description=Proxmox Backup Server
After=network-online.target local-fs.target

[Container]
Image=localhost/proxmox-backup-server:latest
PodmanArgs=--hostname=MicroOS-PBS
Network=host
# PublishPort only takes effect with Network=bridge; ignored in host mode
PublishPort=8007:8007

# Persistence
# Config
Volume=/var/lib/config/pbs:/etc/proxmox-backup:Z
Volume=/var/lib/data/pbs:/var/lib/proxmox-backup:Z
# Logs
Volume=/var/log/pbs:/var/log/proxmox-backup:Z

# Capabilities
AddCapability=SYS_RAWIO

# Mount /run as tmpfs (Required by PBS for shared memory/locking)
Tmpfs=/run
# Ensure the required subdirectory exists in the /run tmpfs
Tmpfs=/run/proxmox-backup:rw,size=64m,mode=1777

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
